# Provider mode: ollama | api | replay
DOCAGENT_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
# Embeddings: fastembed (default, works hosted + local) or ollama (local only). Rebuild the index if you change it.
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
OLLAMA_HOST=http://localhost:11434

# Hosted/free API (OpenAI-compatible). Examples:
#  Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#  Groq:   https://api.groq.com/openai/v1
#  OpenRouter: https://openrouter.ai/api/v1
API_BASE_URL=
API_KEY=
API_MODEL=

GUARDRAILS=on
USE_CRITIC=on
